# Backend Environment Variables

# MongoDB Connection
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/campusstream?retryWrites=true&w=majority

# Auth0 Configuration
AUTH0_DOMAIN=your-domain.auth0.com
AUTH0_AUDIENCE=your-auth0-api-identifier
AUTH0_ISSUER=https://your-domain.auth0.com/

# Cloudinary Configuration (FREE TIER: 25GB storage, 25GB bandwidth/month)
# Sign up at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Google Gemini AI API (FREE TIER: 1500 requests/day)
# Get your API key at https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development
