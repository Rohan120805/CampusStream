# Backend Environment Variables

# MongoDB Connection
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/campusstream?retryWrites=true&w=majority

# Auth0 Configuration
AUTH0_DOMAIN=your-domain.auth0.com
AUTH0_AUDIENCE=your-auth0-api-identifier
AUTH0_ISSUER=https://your-domain.auth0.com/

# Google Cloud Storage (Local Development - use GCS_KEY_FILE)
GCS_PROJECT_ID=your-project-id
GCS_BUCKET_NAME=your-bucket-name
GCS_KEY_FILE=gcs-key.json

# Google Cloud Storage (Production/Vercel - use GCS_CREDENTIALS)
# GCS_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"..."}

# Google AI API
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development
