# Frontend Environment Variables

# Auth0 Configuration
REACT_APP_AUTH0_DOMAIN=your-domain.auth0.com
REACT_APP_AUTH0_CLIENT_ID=your-auth0-client-id
REACT_APP_AUTH0_AUDIENCE=your-auth0-api-identifier

# Auth0 Redirect URI (optional - defaults to window.location.origin)
# REACT_APP_AUTH0_REDIRECT_URI=http://localhost:3000

# API URL (optional)
# In production (Vercel) the app automatically uses /api as a relative path.
# Only set this if your backend is hosted on a separate, non-localhost domain
# (e.g., a Railway or Render deployment).  Do NOT set this to a localhost URL
# when deploying to Vercel – it will override the production /api path and
# cause ERR_CONNECTION_REFUSED errors in the browser.
# REACT_APP_API_URL=https://your-backend.up.railway.app/api
